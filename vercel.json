{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/photography/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sports/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/momo/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/about/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/initiatives/",
      "destination": "/build/",
      "permanent": true
    },
    {
      "source": "/writings/",
